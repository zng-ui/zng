# build
cargo build --manifest-path tests/cargo-zng-res-tests/sfx/res/run-exe/Cargo.toml --target-dir "$ZR_TARGET/run-exe-tmp"

# move executable
src="$ZR_TARGET/run-exe-tmp/debug/run-exe"
dst="$ZR_TARGET/run-exe"
if [ -f "$src.exe" ]; then
    mv "$src.exe" "$dst.exe"
else
    mv "$src" "$dst"
fi

# clean
rm -rf "$ZR_TARGET/run-exe-tmp"
rm -rf "$ZR_TARGET/package-temp"